{
  "name": "dsdst-customer-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "dev:client": "vite",
    "start": "node dist-server/server/index.js",
    "build": "npm run build:client && npm run build:widget && npm run build:server",
    "build:client": "vite build",
    "build:widget": "vite build --config widget/vite.config.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "node --import tsx --test server/*/*.test.ts server/*/*/*.test.ts",
    "db:migrate": "tsx server/db/migrate-cli.ts",
    "backup": "node dist-server/server/db/backup-cli.js"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "imapflow": "^2.0.7",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.28",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sanitize-html": "^2.17.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
